{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.14"
  },
  "type": "row",
  "theme": "goatty",
  "ui_font": "Geist",
  "preview": "layouts/goatty.svg",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": {
    "gradient": [
      "#181513",
      "#0f0d0c"
    ],
    "angle": 180
  },
  "terminal_padding": [
    14,
    14
  ],
  "terminal_opacity": 0.96,
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 288
      },
      "min": 44,
      "max": 480,
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "goatty-chrome",
            "props": {
              "role": "side"
            }
          },
          "size": {
            "px": 48
          },
          "window_drag": true
        },
        {
          "id": "sessions",
          "type": "block",
          "content": {
            "mod": "goatty-chrome",
            "props": {
              "role": "sessions"
            }
          },
          "size": {
            "weight": 1
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "goatty-chrome",
            "props": {
              "role": "foot"
            }
          },
          "size": {
            "px": 52
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "goatty-chrome",
            "props": {
              "role": "title"
            }
          },
          "size": {
            "px": 48
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": [
            0,
            10
          ],
          "gap": 10,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 14,
                  "background": "#1b1917f2",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "#ffffff14"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#ffffff2e"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "hover"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "goatty-chrome",
            "props": {
              "role": "status"
            }
          },
          "size": {
            "px": 38
          }
        }
      ]
    }
  ]
}